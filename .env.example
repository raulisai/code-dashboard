MONITOR_USER=admin
MONITOR_PASSWORD=change-this-to-a-long-random-password
STATE_CACHE_TTL=4
# Agente por defecto para mensajes y proyectos nuevos: claude | codex
DEFAULT_PROVIDER=claude
# Permisos de Claude en peticiones desde la web:
#   ask   = ediciones del proyecto aceptadas; cualquier otra acción se aprueba en la web
#   auto  = el clasificador de Claude decide sin preguntar
#   edits = solo lectura y ediciones, sin comandos
CLAUDE_PERMISSION_MODE=ask
# Sandbox de Codex: full (equivale a codex --yolo) | workspace | read-only
CODEX_SANDBOX=full
# Modelos (vacío = el predeterminado de cada CLI)
CLAUDE_MODEL=
CODEX_MODEL=
# Minutos máximos por petición antes de detenerla
RUN_TIMEOUT_MINUTES=180
# Máximo de días al marcar «Recordar este dispositivo», tras verificar el autenticador
# Sin marcar: cookie de navegador y máximo 12 horas. Límite superior: 180 días.
SESSION_DAYS=180
# Wear OS (opcional): la conversación funciona sin Firebase.
# Copiar las opciones públicas a /config/wear-firebase-client.json y la cuenta
# privada de servicio a /config/wear-firebase-service-account.json (0600).
# WEAR_FCM_CREDENTIALS=/config/wear-firebase-service-account.json
